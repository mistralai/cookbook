# Azure AI Foundry Configuration
# Copy this file to .env and fill in your actual values


# Mistral Document AI Configuration (Azure Foundry)
AZURE_MISTRAL_DOCUMENT_AI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/providers/mistral/azure/ocr
AZURE_MISTRAL_DOCUMENT_AI_KEY=<your-azure-ai-foundry-api-key>
AZURE_AI_DEPLOYMENT_NAME=mistral-ocr-4-0

