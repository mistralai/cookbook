# Copy to .env and fill in secrets. Endpoints/deployments are pre-filled for the
# Bicep-provisioned resources (account: aif-mistral-docai, West US).
#
#   cp .env.example .env
#
# Fetch the shared account key:
#   az cognitiveservices account keys list \
#     --name aif-mistral-docai -g rg-mistral-ocr-example --query key1 -o tsv
# Fetch the storage connection string:
#   az storage account show-connection-string \
#     --name <storageAccountName> -g rg-mistral-ocr-example --query connectionString -o tsv

# ---- Foundry (Mistral models) — shared account key ----
AZURE_AI_KEY=""

# OCR (Mistral OCR 4)
AZURE_OCR_ENDPOINT="https://aif-mistral-docai.services.ai.azure.com/providers/mistral/azure/ocr"
AZURE_OCR_DEPLOYMENT="mistral-ocr-4"

# Chat / reasoning (Mistral Medium 3.5) — Azure AI inference endpoint (base; /openai/v1 is appended)
AZURE_INFERENCE_ENDPOINT="https://aif-mistral-docai.services.ai.azure.com"
AZURE_CHAT_DEPLOYMENT="mistral-medium-3-5"

# Foundry project endpoint (Bicep output projectEndpoint). REQUIRED for the hosted-agent
# path: agents_enabled() is true only when this is set and USE_FOUNDRY_AGENTS is on. Also
# used for evaluation and the Projects SDK.
AZURE_AI_PROJECT_ENDPOINT="https://aif-mistral-docai.services.ai.azure.com/api/projects/proj-mortgage-doc-pipeline"

# Run the model steps as hosted Foundry Agent Service agents (server-side, with per-agent
# portal traces) instead of inline /chat/completions. When true AND AZURE_AI_PROJECT_ENDPOINT
# is set: the pipeline extractor (workflow.py) and the app's intake/underwriting steps
# (underwriting_service.py) route through Agent Service, each falling back to /chat/completions
# on error. Auth is Entra: the Function's managed identity in Azure, or `az login` locally.
USE_FOUNDRY_AGENTS="true"

# Rehearsal safety. When true, a failed server-side agent run raises instead of falling back
# to /chat/completions, so an empty portal Traces tab surfaces as a loud error you catch in
# rehearsal rather than on stage. Leave empty/false in production so a demo never loses an
# answer. Before the session, prefer probing once: uv run python scripts/probe_agent.py
# FOUNDRY_AGENTS_STRICT="false"

# Storage (blob upload + Function trigger)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_INBOX_CONTAINER="inbox"
AZURE_STORAGE_RESULTS_CONTAINER="results"
# SQS-equivalent ingest queue (Event Grid bridges BlobCreated -> this queue)
AZURE_STORAGE_INGEST_QUEUE="ingest"

# ---- Observability (Azure Monitor / OpenTelemetry) ----
# From: az monitor app-insights component show --app appi-mistral-docai -g <rg> --query connectionString -o tsv
APPLICATIONINSIGHTS_CONNECTION_STRING=""
# Capture prompts/completions (document text) in traces. Set false for metadata-only.
ENABLE_SENSITIVE_TELEMETRY="true"
OTEL_SERVICE_NAME="doc-pipeline"
# Local-only: print spans to console instead of Azure Monitor (leave connection string empty)
# ENABLE_CONSOLE_EXPORTERS="true"
