# syntax=docker/dockerfile:1
FROM python:3.14-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /uvx /bin/
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
# uv bytecode-compiles each file under a 60 s default timeout, which a loaded build host can exceed;
# 900 s still fails a hung compile.
ENV UV_PYTHON_PREFERENCE=only-system \
    UV_NO_PYTHON_DOWNLOADS=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_COMPILE_BYTECODE_TIMEOUT=900
COPY pyproject.toml uv.lock ./
COPY tools/uv.sh tools/
RUN --mount=type=secret,id=registry_token --mount=type=cache,target=/root/.cache/uv \
    bash tools/uv.sh sync --all-packages --frozen --no-dev --no-install-local
COPY . .
RUN --mount=type=secret,id=registry_token --mount=type=cache,target=/root/.cache/uv \
    bash tools/uv.sh sync --all-packages --frozen --no-dev

FROM python:3.14-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /uvx /bin/
WORKDIR /app
ENV UV_PYTHON_PREFERENCE=only-system \
    UV_NO_PYTHON_DOWNLOADS=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    XDG_CACHE_HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:${PATH}"
RUN groupadd -g 1000 app && \
    useradd -u 1000 -g 1000 -m -s /usr/sbin/nologin app
COPY --from=build --chown=1000:1000 /app /app
USER 1000:1000

FROM runtime AS workflows
# The Debian packages the selected capabilities' worker code needs: each lists its own in
# deploy/docker/worker-packages/<capability>.txt (see install.sh there). Installed here, not in build
# or runtime, so those stay byte-identical across the Python images and BuildKit builds them once
# for api, worker and init. The apt lists are a cache mount, so a rerun skips most of `apt-get
# update`, and the script exits at once when no capability lists any.
USER 0:0
RUN --mount=type=bind,source=deploy/docker/worker-packages,target=/tmp/worker-packages \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    sh /tmp/worker-packages/install.sh
USER 1000:1000
ENV HEALTH_SERVER_HOST=127.0.0.1 HEALTH_SERVER_PORT=3001
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=20s \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:3001/health', timeout=5).status==200 else 1)"
CMD ["sh", "-c", "exec uv run --frozen --no-dev --no-sync --directory apps/worker python -m worker.entrypoints.worker"]

FROM build AS development
# The capabilities' Debian packages, as in the workflows stage.
RUN --mount=type=bind,source=deploy/docker/worker-packages,target=/tmp/worker-packages \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    sh /tmp/worker-packages/install.sh
RUN --mount=type=secret,id=registry_token --mount=type=cache,target=/root/.cache/uv \
    bash tools/uv.sh sync --all-packages --frozen
ENV UV_CACHE_DIR=/tmp/uv-cache \
    XDG_CACHE_HOME=/tmp \
    HOME=/tmp \
    UV_NO_SYNC=1 \
    WATCHFILES_FORCE_POLLING=true \
    PATH="/app/.venv/bin:${PATH}"

FROM development AS workflows-dev
CMD ["sh", "-c", "exec uv run --no-sync --directory apps/worker python -m worker.entrypoints.dev"]

FROM workflows AS default
