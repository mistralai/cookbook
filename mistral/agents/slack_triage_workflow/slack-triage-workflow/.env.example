# Copy this file to `.env` and fill it in. Every other setting has a default in packages/py/env.
MISTRAL_API_KEY=
# The deployment your local worker registers on. Pick a name of your own, such as slack-triage-<you>.
DEPLOYMENT_NAME=

# packages/py/env/src/env/triage.py. TRIAGE_MODEL defaults to mistral-medium-latest.
TRIAGE_MODEL=
SLACK_BOT_TOKEN=
INTERCOM_CONNECTOR_NAME=
INTERCOM_TICKET_TYPE_ID=
INTERCOM_WORKSPACE_ID=
TRACKER_CONNECTOR_NAME=
# Only for an EU or Australian Intercom workspace, for example https://app.eu.intercom.com.
INTERCOM_APP_URL=
